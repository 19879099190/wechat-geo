# 服务器配置
PORT=4000
WS_PORT=4001

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=huanong_palm

# JWT密钥
JWT_SECRET=your_jwt_secret_key_change_this

# 微信小程序配置
WX_APPID=your_appid
WX_SECRET=your_appsecret

# 腾讯地图 WebServiceAPI 密钥（仅后端使用，禁止放入 front/）
TENCENT_MAP_KEY=your_tencent_map_key
# 仅当腾讯地图 Key 使用域名来源限制时配置；更推荐生产服务器 IP 白名单
TENCENT_MAP_REFERER=https://your-domain.example

