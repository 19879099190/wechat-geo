.route-page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 28rpx 140rpx; background: #f4f7f4; }
.page-head { padding: 20rpx 8rpx 36rpx; }
.title { font-size: 48rpx; font-weight: 700; color: #17351f; }
.subtitle { margin-top: 10rpx; color: #718076; font-size: 26rpx; }
.state, .empty-card { text-align: center; color: #829087; }
.state { padding: 120rpx 0; }
.empty-card { padding: 80rpx 30rpx; border-radius: 28rpx; background: #fff; }
.empty-icon { margin: auto; width: 90rpx; height: 90rpx; line-height: 90rpx; border-radius: 45rpx; background: #e5f4e8; color: #2e7d32; font-size: 48rpx; }
.empty-title { margin-top: 28rpx; color: #263d2c; font-size: 32rpx; font-weight: 600; }
.empty-desc { margin-top: 12rpx; font-size: 25rpx; }
.route-card { margin-bottom: 22rpx; padding: 30rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(31, 69, 41, .06); }
.route-name { margin-bottom: 26rpx; font-size: 32rpx; font-weight: 650; color: #1c3422; }
.point-row { display: flex; align-items: center; gap: 18rpx; color: #415048; font-size: 27rpx; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; }
.dot.start { background: #43a047; }.dot.end { background: #ef5350; }
.line { width: 2rpx; height: 28rpx; margin-left: 8rpx; background: #d4ddd6; }
.meta { display: flex; gap: 22rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf1ed; color: #718076; font-size: 24rpx; }
.card-actions { display: flex; justify-content: flex-end; gap: 18rpx; margin-top: 22rpx; }
.small-btn { margin: 0; padding: 0 30rpx; font-size: 25rpx; line-height: 64rpx; border-radius: 32rpx; }
.small-btn.danger { color: #d34b4b; background: #fff0f0; }.small-btn.primary { color: #fff; background: #2e7d32; }
.add-btn { position: fixed; left: 28rpx; right: 28rpx; bottom: 30rpx; color: #fff; background: #2e7d32; border-radius: 48rpx; }
