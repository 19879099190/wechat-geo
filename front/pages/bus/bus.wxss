/* pages/bus/bus.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.bus-list {
  padding: 20rpx;
}

.bus-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.bus-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bus-number {
  background-color: #2E7D32;
  color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 12rpx;
}

.bus-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.bus-route {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-text {
  flex: 1;
}

.arrow {
  margin: 0 12rpx;
  color: #2E7D32;
  font-weight: bold;
}

.bus-info {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}

.info-icon {
  margin-right: 6rpx;
}

.info-text {
  color: #333333;
}

.bus-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  color: #333333;
}

.action-btn.primary {
  background-color: #2E7D32;
  color: #ffffff;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  height: 80vh;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-content.small {
  height: 60vh;
  max-height: 60vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #2E7D32;
  color: #ffffff;
}

.modal-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}

.line-number {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.line-name {
  font-size: 32rpx;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #ffffff;
}

.modal-body {
  height: calc(80vh - 104rpx);
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

.modal-content.small .modal-body {
  height: calc(60vh - 104rpx);
}

.detail-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #2E7D32;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.detail-label {
  color: #666666;
  min-width: 140rpx;
}

.detail-value {
  color: #333333;
  flex: 1;
}

/* 站点列表 */
.station-list {
  padding-left: 20rpx;
}

.station-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  position: relative;
}

.station-dot {
  position: relative;
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #2E7D32;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #2E7D32;
  z-index: 2;
}

.line {
  width: 2rpx;
  flex: 1;
  min-height: 40rpx;
  background-color: #e0e0e0;
  margin-top: 4rpx;
}

.station-info {
  flex: 1;
  padding-left: 16rpx;
}

.station-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.station-time {
  font-size: 24rpx;
  color: #999999;
}

.station-actions {
  display: flex;
  gap: 12rpx;
}

.icon-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.modal-footer {
  padding: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  width: 100%;
  background-color: #2E7D32;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 24rpx;
}

/* 实时位置 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.realtime-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.realtime-item {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
}

.bus-badge {
  display: inline-block;
  background-color: #2E7D32;
  color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.realtime-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.info-row .label {
  color: #666666;
  min-width: 140rpx;
}

.info-row .value {
  color: #333333;
  flex: 1;
}

.info-row .value.highlight {
  color: #2E7D32;
  font-weight: bold;
}

/* 路线地图弹窗 */
.map-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #ffffff;
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.map-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.map-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #666666;
}

.route-map {
  width: 100%;
  height: calc(100vh - 100rpx);
}
