.detail-container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 120rpx;
}

/* 图片轮播 */
.image-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 打卡区块 */
.checkin-section {
  background: #ffffff;
  margin-bottom: 16rpx;
  padding: 32rpx;
}

.checkin-success {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkin-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkin-icon {
  font-size: 48rpx;
}

.checkin-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.checkin-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4caf50;
}

.checkin-time {
  font-size: 24rpx;
  color: #999999;
}

.checkin-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
}

.checkin-pending {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffeef0 0%, #fff5f7 100%);
  border-radius: 16rpx;
}

.checkin-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-icon {
  font-size: 32rpx;
}

.status-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.checkin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.checkin-btn.active {
  background: linear-gradient(135deg, #ff6b9d 0%, #ff9a9e 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.4);
}

.checkin-btn.disabled {
  background: #e0e0e0;
  color: #999999;
}

.checkin-btn:active {
  transform: scale(0.98);
}

.checkin-tip {
  font-size: 24rpx;
  color: #999999;
}

/* 功能按钮组 */
.function-bar {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.func-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.func-btn.live {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
}

.func-btn.live .func-icon,
.func-btn.live .func-text {
  color: #ffffff;
}

.func-icon {
  font-size: 32rpx;
}

.func-text {
  font-size: 24rpx;
  color: #666666;
}

.func-btn:active {
  transform: scale(0.95);
}

/* 基本信息 */
.info-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.spot-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.header-left {
  flex: 1;
}

.spot-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.spot-status {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.spot-status.blooming {
  background: #e8f5e9;
  color: #4caf50;
}

.spot-status.upcoming {
  background: #fff3e0;
  color: #ff9800;
}

.rating-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #fff3e0;
  border-radius: 24rpx;
}

.rating-star {
  font-size: 28rpx;
}

.rating-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff9800;
}

/* 元数据 */
.meta-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #999999;
}

.meta-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

/* 描述 */
.description {
  margin-bottom: 24rpx;
}

.desc-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.desc-content {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* 特色标签 */
.features {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feature-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #ffeef0 0%, #fff5f7 100%);
  color: #ff6b9d;
  font-size: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ffcdd2;
}

/* 浏览次数 */
.view-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.count-separator {
  margin: 0 8rpx;
  color: #e0e0e0;
}

.count-icon {
  font-size: 28rpx;
}

.count-text {
  font-size: 24rpx;
  color: #999999;
}

/* 通用区块 */
.section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 设施服务 */
.facilities {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.facility-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.facility-icon {
  font-size: 24rpx;
  color: #4caf50;
  font-weight: 600;
}

.facility-text {
  font-size: 26rpx;
  color: #666666;
}

/* 提示 */
.tips-box {
  background: #fff9e6;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid #ffc107;
}

.tip-item {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-bullet {
  font-size: 28rpx;
  color: #ffc107;
  font-weight: 600;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 附近赏花点 */
.nearby-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.nearby-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.nearby-item:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.nearby-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.nearby-distance {
  font-size: 24rpx;
  color: #2196f3;
}

/* 用户评价 */
.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.review-rating {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 20rpx;
}

.review-time {
  font-size: 24rpx;
  color: #999999;
}

.review-content {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.review-images {
  display: flex;
  gap: 16rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.icon-btn {
  flex: 0 0 160rpx;
  background: #f8f9fa;
  color: #666666;
}

.primary-btn {
  flex: 1;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 158, 0.4);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}

.bar-btn:active {
  transform: scale(0.98);
}

/* 视频播放器 */
.video-modal,
.viewer-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
}

.video-wrapper,
.viewer-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.viewer-placeholder {
  display: block;
  text-align: center;
  padding: 100rpx;
  color: #ffffff;
  font-size: 32rpx;
}

.close-icon {
  position: absolute;
  top: -80rpx;
  right: 0;
}


