.routes-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fef5f8 0%, #ffffff 100%);
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top: 4rpx solid #ff9a9e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 路线列表 */
.routes-list {
  padding: 0 32rpx;
}

.route-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin-top: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(255, 154, 158, 0.15);
}

/* 路线信息 */
.route-info {
  padding: 32rpx;
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.route-title-group {
  flex: 1;
}

.route-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

/* 难度标签 */
.difficulty-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.difficulty-easy {
  background: #e8f5e9;
  color: #4caf50;
}

.difficulty-medium {
  background: #fff3e0;
  color: #ff9800;
}

.difficulty-hard {
  background: #fce4ec;
  color: #e91e63;
}

/* 元数据 */
.route-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #666666;
}

/* 描述 */
.route-description {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

/* 特色标签 */
.route-features {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feature-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #ffeef0 0%, #fff5f7 100%);
  color: #ff6b9d;
  font-size: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ffcdd2;
}

/* 景点预览 */
.spots-preview {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  border-left: 4rpx solid #2196f3;
}

.spots-title {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.spots-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.spot-name {
  font-size: 26rpx;
  color: #2196f3;
  font-weight: 500;
}

.spot-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 操作按钮 */
.route-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-btn {
  background: #f8f9fa;
  color: #666666;
}

.map-btn {
  background: #e3f2fd;
  color: #1976d2;
}

.nav-btn {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 158, 0.4);
}

.action-btn:active {
  transform: scale(0.98);
}

/* 路线底部 */
.route-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.best-time {
  font-size: 24rpx;
  color: #999999;
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.close-icon {
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  text-align: center;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

/* 时间轴 */
.spots-timeline {
  position: relative;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 28rpx;
  top: 56rpx;
  bottom: -32rpx;
  width: 2rpx;
  background: #e0e0e0;
}

.timeline-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 158, 0.3);
}

.timeline-content {
  flex: 1;
  padding-top: 8rpx;
}

.spot-name-large {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.spot-time {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.spot-type {
  display: block;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 4rpx;
}

/* 提示列表 */
.tips-list {
  background: #fff9e6;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid #ffc107;
}

.tip-item {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-bullet {
  font-size: 28rpx;
  color: #ffc107;
  font-weight: 600;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 弹窗底部 */
.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 158, 0.4);
}

.modal-btn.secondary {
  background: #e3f2fd;
  color: #1976d2;
}

.modal-btn:active {
  transform: scale(0.98);
}

/* 地图弹窗 */
.map-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.map-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.map-planning {
  margin-left: 16rpx;
  color: #ff6b9d;
  font-size: 24rpx;
}

.map-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.route-map {
  flex: 1;
  width: 100%;
}
