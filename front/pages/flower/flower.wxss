/* 赏花专题样式 */
.flower-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #ffeef8 0%, #fff5f7 100%);
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
}

.search-icon {
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  margin-left: 16rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #ff6b9d 0%, #c86dd7 100%);
  margin: 20rpx 30rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.3);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-number.blooming {
  color: #ffeb3b;
}

.stat-number.upcoming {
  color: #b3e5fc;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 功能按钮 */
.function-buttons {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.function-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.function-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.function-text {
  font-size: 24rpx;
  color: #666;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  padding: 20rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}

.category-list {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, #ff6b9d 0%, #c86dd7 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.3);
}

/* 赏花点列表 */
.spots-list {
  padding: 0 30rpx;
}

.spot-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s;
}

.spot-card:active {
  transform: scale(0.98);
}

.spot-image-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.spot-image {
  width: 100%;
  height: 100%;
}

.spot-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

.spot-status.blooming {
  background: linear-gradient(135deg, #ff6b9d 0%, #c86dd7 100%);
}

.spot-status.upcoming {
  background: linear-gradient(135deg, #4fc3f7 0%, #29b6f6 100%);
}

.spot-status.ended {
  background: rgba(0, 0, 0, 0.5);
}

.spot-badges {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.badge {
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
  border-radius: 50rpx;
  font-size: 20rpx;
  color: #fff;
}

.badge.live {
  background: rgba(255, 0, 0, 0.8);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.spot-info {
  padding: 30rpx;
}

.spot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.spot-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.spot-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  font-size: 28rpx;
}

.rating-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b9d;
}

.spot-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.spot-type {
  color: #ff6b9d;
  font-weight: bold;
}

.spot-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.spot-features {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.feature-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #ffeef8 0%, #fff5f7 100%);
  border: 2rpx solid #ff6b9d;
  border-radius: 50rpx;
  font-size: 24rpx;
  color: #ff6b9d;
}

.spot-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.view-count {
  font-size: 24rpx;
  color: #999;
}

.spot-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #c86dd7 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* GIS分析面板 */
.gis-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.panel-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  animation: slideUp 0.3s;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.panel-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.panel-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.picker-value {
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.button-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.primary-btn {
  flex: 1;
  background: linear-gradient(135deg, #ff6b9d 0%, #c86dd7 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 24rpx;
}

.secondary-btn {
  flex: 1;
  background: #fff;
  color: #ff6b9d;
  border: 2rpx solid #ff6b9d;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 24rpx;
}

/* 搜索结果 */
.search-results {
  margin-top: 30rpx;
}

.results-header {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.results-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.result-info {
  flex: 1;
}

.result-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.result-type {
  font-size: 24rpx;
  color: #999;
}

.result-distance {
  font-size: 24rpx;
  color: #ff6b9d;
  font-weight: bold;
}
