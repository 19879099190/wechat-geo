<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-info" bindtap="onUserInfoTap">
    <image class="avatar" src="{{userInfo.avatar || '/images/R-C.jpg'}}" mode="aspectFill"></image>
    <view class="nickname">{{userInfo.nickname}}</view>
    <view class="phone" wx:if="{{isLogin && userInfo.phone}}">{{userInfo.phone}}</view>
    <view class="login-tip" wx:if="{{!isLogin}}">点击登录</view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <view 
      wx:for="{{menuList}}" 
      wx:key="name" 
      class="menu-item"
      bindtap="onMenuTap"
      data-url="{{item.url}}"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 关于 -->
  <view class="about">
    <view class="about-title">华农掌中行</view>
    <view class="about-version">v0.1.1</view>
  </view>
</view>
