/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.user-info {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #ffffff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #ffffff;
  margin-bottom: 20rpx;
  background-color: #ffffff;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #81C784 0%, #66BB6A 100%);
  margin: 0 auto 20rpx;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 28rpx;
  opacity: 0.9;
}

.login-tip {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.menu-list {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-name {
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 48rpx;
  color: #cccccc;
}

/* 退出登录 */
.logout-section {
  padding: 20rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: #ffffff;
  color: #F44336;
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.logout-btn:active {
  opacity: 0.8;
}

.about {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #999999;
}

.about-title {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.about-version {
  font-size: 24rpx;
}

