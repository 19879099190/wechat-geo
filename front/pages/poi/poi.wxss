/* pages/poi/poi.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.filter-bar {
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.arrow {
  color: #999999;
}

.poi-list {
  padding: 0 20rpx;
}

.poi-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.poi-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.poi-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.poi-type {
  color: #2E7D32;
  background-color: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.poi-rating {
  color: #FF9800;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

