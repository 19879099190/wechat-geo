/* pages/poi/detail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header-image {
  width: 100%;
  height: 400rpx;
  background-color: #e0e0e0;
}

.header-image image {
  width: 100%;
  height: 100%;
}

.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  color: #999999;
}

.info-card {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.poi-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.poi-type {
  display: inline-block;
  background-color: #E8F5E9;
  color: #2E7D32;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.rating-box {
  margin: 16rpx 0;
}

.rating {
  font-size: 28rpx;
  color: #FF9800;
}

.description {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin: 20rpx 0;
}

.open-time {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
}

.label {
  font-weight: bold;
  color: #666666;
}

.action-buttons {
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: transparent;
  border: none;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.action-btn::after {
  border: none;
}

.action-btn .icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.ratings-section {
  background-color: #ffffff;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.rating-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.rating-item:last-child {
  border-bottom: none;
}

.rating-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.user {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.stars {
  font-size: 24rpx;
  color: #FF9800;
}

.comment {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999999;
}

.empty-ratings {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

