<!--pages/poi/poi.wxml-->
<view class="container">
  <!-- 类型筛选 -->
  <view class="filter-bar">
    <picker mode="selector" range="{{types}}" range-key="label" value="{{currentTypeIndex}}" bindchange="onTypeChange">
      <view class="picker">
        <text>{{types[currentTypeIndex].label}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- POI列表 -->
  <view class="poi-list">
    <view wx:if="{{loading}}" class="loading">加载中...</view>
    
    <view wx:elif="{{poiList.length === 0}}" class="empty">
      <view class="empty-icon">📍</view>
      <view class="empty-text">暂无数据</view>
    </view>
    
    <view wx:else>
      <view 
        wx:for="{{poiList}}" 
        wx:key="id" 
        class="poi-item"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <view class="poi-name">{{item.name}}</view>
        <view class="poi-desc">{{item.description}}</view>
        <view class="poi-info">
          <text class="poi-type">{{item.type}}</text>
          <text class="poi-rating">⭐ {{item.rating || '暂无评分'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
