<!--pages/charging/reservations/reservations.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-icon">⚡</view>
    <text>加载中...</text>
  </view>

  <view wx:elif="{{reservationList.length === 0}}" class="empty">
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无预约记录</text>
    <navigator url="/pages/charging/charging" class="empty-btn">
      <text>去预约充电桩</text>
    </navigator>
  </view>

  <view wx:else class="reservation-list">
    <view class="reservation-item" wx:for="{{reservationList}}" wx:key="id">
      <view class="item-header">
        <view class="station-info">
          <text class="station-icon">🔌</text>
          <text class="station-name">{{item.station_name}}</text>
        </view>
        <view class="status" style="color: {{statusColor[item.status]}}">
          {{statusText[item.status]}}
        </view>
      </view>

      <view class="item-content">
        <view class="info-row">
          <text class="label">📍 位置：</text>
          <text class="value">{{item.location}}</text>
        </view>
        <view class="info-row">
          <text class="label">🕐 预约时间：</text>
          <text class="value">{{item.start_time_display}}</text>
        </view>
        <view class="info-row">
          <text class="label">⏱ 预计时长：</text>
          <text class="value">{{item.duration}}分钟</text>
        </view>
        <view class="info-row" wx:if="{{item.status === 1 && item.remainingTime}}">
          <text class="label">⏰ 有效期：</text>
          <text class="value {{item.isExpired ? 'expired' : 'remaining'}}">{{item.remainingTime}}</text>
        </view>
        <view class="info-row">
          <text class="label">📱 联系电话：</text>
          <text class="value">{{item.phone}}</text>
        </view>
      </view>

      <view class="item-actions">
        <button class="action-btn" size="mini" bindtap="viewDetail" data-id="{{item.station_id}}">
          查看详情
        </button>
        <button 
          class="action-btn cancel" 
          size="mini" 
          bindtap="cancelReservation" 
          data-id="{{item.id}}"
          wx:if="{{item.status === 1}}"
        >
          取消预约
        </button>
      </view>
    </view>
  </view>
</view>

