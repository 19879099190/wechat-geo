.suggestion-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 26rpx 60rpx; background: #f4f7f4; }
.intro { padding: 34rpx 22rpx 42rpx; text-align: center; }.intro-icon { margin: auto; width: 92rpx; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; color: #fff; background: linear-gradient(135deg, #f9a825, #ffca28); font-size: 46rpx; }.intro-title { margin-top: 22rpx; color: #203627; font-size: 38rpx; font-weight: 700; }.intro-desc { margin: 14rpx auto 0; max-width: 600rpx; color: #78847c; font-size: 25rpx; line-height: 1.6; }
.form-card, .history-item { background: #fff; border-radius: 24rpx; box-shadow: 0 7rpx 24rpx rgba(28, 68, 38, .06); }.form-card { padding: 30rpx; }.field-label { margin-bottom: 14rpx; color: #304737; font-size: 28rpx; font-weight: 600; }.reason-label { margin-top: 30rpx; }.location-picker { display: flex; align-items: center; min-height: 86rpx; padding: 0 22rpx; border: 2rpx solid #e1e8e2; border-radius: 16rpx; }.pin { margin-right: 16rpx; color: #2e7d32; font-size: 34rpx; }.location-text { flex: 1; color: #32483a; font-size: 27rpx; }.placeholder { color: #a1aaa3; }.arrow { color: #9da69f; font-size: 38rpx; }
.reason-input { box-sizing: border-box; width: 100%; min-height: 230rpx; padding: 22rpx; background: #f7f9f7; border-radius: 16rpx; font-size: 27rpx; line-height: 1.55; }.counter { margin-top: 8rpx; color: #a0aaa2; text-align: right; font-size: 22rpx; }.submit-btn { margin-top: 30rpx; color: #fff; background: #2e7d32; border-radius: 44rpx; }
.history { margin-top: 38rpx; }.history-title { margin: 0 4rpx 18rpx; color: #263c2c; font-size: 31rpx; font-weight: 650; }.history-item { margin-bottom: 18rpx; padding: 25rpx; }.history-head { display: flex; justify-content: space-between; color: #304737; font-size: 28rpx; font-weight: 600; }.status { padding: 5rpx 14rpx; color: #b47c00; background: #fff5d9; border-radius: 16rpx; font-size: 21rpx; }.status-1 { color: #2e7d32; background: #e8f5e9; }.status-2 { color: #b33b3b; background: #ffebee; }.history-reason { margin-top: 14rpx; color: #67736b; font-size: 25rpx; line-height: 1.5; }.history-time { margin-top: 12rpx; color: #a2aaa4; font-size: 21rpx; }
