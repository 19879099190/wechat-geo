/* pages/charging/detail/detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #f5f5f5 100%);
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
}

.info-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-header-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.station-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  flex: 1;
  line-height: 1.3;
}

.status-box {
  margin-left: 20rpx;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.status-icon {
  font-size: 20rpx;
}

.status-0 {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.status-1 {
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
}

.status-2 {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
}

.status-3 {
  background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%);
}

.location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background-color: #f0f9ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.location-icon {
  font-size: 28rpx;
}

.location-text {
  font-size: 26rpx;
  color: #1890ff;
  flex: 1;
}

.detail-info {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  border: 2rpx solid #f0f0f0;
}

.info-icon {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.label {
  font-size: 22rpx;
  color: #999999;
}

.value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

/* 我的预约卡片 */
.reservation-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  position: relative;
  overflow: hidden;
}

.reservation-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.card-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
}

.reservation-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.25);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  backdrop-filter: blur(10rpx);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #52c41a;
  border-radius: 50%;
  animation: blink 1.5s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.reservation-info {
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 28rpx;
  margin-top: 2rpx;
}

.info-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
}

.info-value.highlight {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd700;
}

.btn-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  position: relative;
  z-index: 1;
}

.btn-icon {
  font-size: 24rpx;
}

/* 操作按钮 */
.action-buttons {
  margin-bottom: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #2E7D32 0%, #43a047 100%);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 0;
  margin-bottom: 16rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
  overflow: hidden;
  position: relative;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #cccccc 0%, #dddddd 100%);
  color: #999999;
  box-shadow: none;
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 30rpx;
}

.btn-icon-large {
  font-size: 48rpx;
}

.btn-text-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
}

.btn-subtext {
  font-size: 22rpx;
  opacity: 0.85;
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background-color: #ffffff;
  color: #2E7D32;
  border: 2rpx solid #e8f5e9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-secondary::after {
  border: none;
}

/* 充电记录 */
.records-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.record-item:last-child {
  margin-bottom: 0;
}

.record-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-user {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: #999999;
}

.record-duration {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 600;
  padding: 6rpx 12rpx;
  background-color: #e8f5e9;
  border-radius: 8rpx;
}

/* 使用说明 */
.tips-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #43a047 100%);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  padding-top: 4rpx;
}

/* 预约对话框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 90%;
  max-height: 85vh;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #43a047 100%);
  color: #ffffff;
}

.modal-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-icon {
  font-size: 36rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.label-icon {
  font-size: 24rpx;
}

.form-value-box {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.form-value {
  font-size: 28rpx;
  color: #666666;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999999;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.cost-info {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  border: 2rpx solid #ffb74d;
}

.cost-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.cost-icon {
  font-size: 28rpx;
}

.cost-title {
  font-size: 26rpx;
  color: #e65100;
  font-weight: bold;
}

.cost-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.cost-label {
  font-size: 28rpx;
  color: #666666;
}

.cost-value {
  font-size: 40rpx;
  color: #ff6b00;
  font-weight: bold;
}

.cost-detail {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.cost-detail-item {
  font-size: 22rpx;
  color: #999999;
}

.cost-tip {
  font-size: 22rpx;
  color: #e65100;
  padding-top: 12rpx;
  border-top: 1rpx dashed #ffb74d;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.modal-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background-color: #ffffff;
  color: #666666;
  border: 2rpx solid #e0e0e0;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #2E7D32 0%, #43a047 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

.confirm-icon {
  font-size: 24rpx;
}

/* 充电中按钮样式 */
.btn-primary.charging {
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
  box-shadow: 0 4rpx 16rpx rgba(250, 140, 22, 0.3);
  animation: charging-pulse 2s ease-in-out infinite;
}

@keyframes charging-pulse {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(250, 140, 22, 0.3); }
  50% { box-shadow: 0 4rpx 24rpx rgba(250, 140, 22, 0.6); }
}

/* 水平按钮组 */
.btn-group-horizontal {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-primary.half {
  flex: 1;
  margin-bottom: 0;
}

.btn-primary.half .btn-content {
  padding: 20rpx;
  flex-direction: column;
  gap: 8rpx;
}

.btn-primary.half .btn-icon-large {
  font-size: 40rpx;
}

.btn-primary.half .btn-text {
  font-size: 28rpx;
}

/* 垂直按钮组 */
.btn-group-vertical {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-group-vertical .btn-primary {
  margin-bottom: 0;
}

/* 取消充电按钮 */
.btn-cancel-charging {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background-color: #ffffff;
  color: #f5222d;
  border: 2rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 34, 45, 0.1);
}

.btn-cancel-charging::after {
  border: none;
}

.btn-cancel-charging .btn-icon {
  font-size: 24rpx;
}