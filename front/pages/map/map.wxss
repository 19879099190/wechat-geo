.container {
  width: 100%;
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

/* 地图控制按钮 */
.map-controls {
  position: absolute;
  right: 20rpx;
  bottom: 100rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.control-btn {
  width: 88rpx;
  height: 88rpx;
  background-color: #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-btn.primary {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
}

.control-icon {
  font-size: 44rpx;
}

.control-btn.primary .control-icon {
  filter: brightness(0) invert(1);
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 99;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

/* 路线规划面板 */
.route-panel {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  max-height: 75vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
  transition: bottom 0.3s ease;
  z-index: 100;
  display: flex;
  flex-direction: column;
}

.route-panel.show {
  bottom: 0;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.panel-close {
  font-size: 48rpx;
  color: #999999;
  padding: 0 10rpx;
  line-height: 1;
}

/* 位置选择区域 */
.location-section {
  padding: 32rpx 40rpx;
  position: relative;
  flex-shrink: 0;
}

.location-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.location-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.start-icon {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
}

.end-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.location-input {
  flex: 1;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.location-text {
  font-size: 30rpx;
  color: #333333;
}

.location-placeholder {
  font-size: 30rpx;
  color: #999999;
}

.location-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.swap-btn {
  display: flex;
  justify-content: center;
  margin: 8rpx 0;
}

.swap-icon {
  font-size: 40rpx;
  color: #2E7D32;
  font-weight: 600;
}

/* 出行方式 */
.mode-section {
  padding: 0 40rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 20rpx;
}

.mode-list {
  display: flex;
  gap: 16rpx;
}

.mode-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.mode-item.active {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  border-color: #2E7D32;
  transform: translateY(-2rpx);
}

.mode-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #666666;
}

.mode-item.active .mode-label {
  color: #ffffff;
  font-weight: 600;
}

/* 操作按钮 */
.action-section {
  padding: 32rpx 40rpx;
  flex-shrink: 0;
}

.plan-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
  transition: all 0.3s ease;
}

.plan-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.2);
}

/* POI搜索面板 */
.poi-search-panel {
  position: fixed;
  top: 100%;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  transition: top 0.3s ease;
  z-index: 200;
  display: flex;
  flex-direction: column;
}

.poi-search-panel.show {
  top: 0;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.search-back {
  font-size: 48rpx;
  color: #333333;
  padding: 0 20rpx;
  line-height: 1;
}

.search-input-wrapper {
  flex: 1;
}

.search-input {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.search-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.search-item {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.search-item:active {
  background: #f8f9fa;
}

.search-item.special {
  background: #f8f9fa;
  border-bottom: 2rpx solid #e0e0e0;
}

.search-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.search-info {
  flex: 1;
  min-width: 0;
}

.search-name {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-desc {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.list-title {
  padding: 24rpx 40rpx 16rpx;
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.poi-scroll {
  flex: 1;
  overflow-y: auto;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
